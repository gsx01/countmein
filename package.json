{
  "name": "countmein",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny carpool planner on a single Cloudflare Worker (Preact SPA + API + D1 + cron).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --env=\"\"",
    "migrate": "wrangler d1 migrations apply countmein --remote --env=\"\"",
    "deploy:staging": "vite build --mode staging && wrangler deploy --env staging",
    "migrate:staging": "wrangler d1 migrations apply countmein-staging --remote --env staging",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "seed:staging": "node scripts/seed.mjs --remote --db countmein-staging"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260906.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/google.maps": "^3.66.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.129.0"
  }
}
