# Copy to .env (gitignored) and fill in your own values. For a staging build,
# also create .env.staging with the values that differ for staging (at least its
# own VAPID_PUBLIC_KEY); `vite build --mode staging` loads it on top of .env.
#
# Every value here is PUBLIC client config - it ships in the browser bundle or
# the printed seed URLs. Never put a secret (the VAPID private key) in this file;
# secrets are set with `wrangler secret put` (see README).

# Origin used by scripts/seed.mjs to build the printed login URLs. Set it to your
# deployed Worker origin. Leave unset for local dev (defaults to http://localhost:5173).
COUNTMEIN_BASE_URL=https://countmein.<your-subdomain>.workers.dev

# Public half of your Web Push VAPID keypair (see README: node scripts/gen-vapid.mjs).
# Must match the VAPID_PUBLIC_KEY Worker var in wrangler.toml.
VAPID_PUBLIC_KEY=<your-vapid-public-key>

# Google Maps browser key: referrer- and quota-restricted in Google Cloud
# (Maps JavaScript API, Places API New, Directions API). Public by design.
GOOGLE_MAPS_API_KEY=<your-google-maps-browser-key>

# Google Maps Map ID (required by Advanced Markers). 'DEMO_MAP_ID' works with no
# setup; swap in a real Map ID to control the map style.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
